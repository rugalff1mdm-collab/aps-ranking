{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aps-ranking",
  "main": "./worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
