{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aps-ranking",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "keep_vars": true
}
